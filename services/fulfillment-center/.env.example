DATABASE_PATH=./data/fulfillment.sqlite3
LOW_STOCK_THRESHOLD=5
MAX_RESET_COUNT=0
CPA_PLATFORM=chatgpt
COCKPIT_BASE_URL=http://127.0.0.1:8000
COCKPIT_API_TOKEN=
XIANYU_BASE_URL=http://127.0.0.1:8090
XIANYU_API_TOKEN=
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=180
DRY_RUN=true

# OAuth reauthorization uses paths on the deployment host, not repository-local paths.
ABAI_PROJECT_ROOT=<path-to-aBaiAutoplus_syunnrai>
COCKPIT_PYTHON=<path-to-aBaiAutoplus_syunnrai>/.venv/Scripts/python.exe
OAUTH_BROWSER_MODE=camoufox_headless
OAUTH_BROWSER_TIMEOUT_SECONDS=300

ACTIVATION_PROVIDER=desktop
REAUTH_BEFORE_ACTIVATION=false

# WebSocket 协议激活（ACTIVATION_PROVIDER=ws，实验性，暂未真实账号验证）
# 不拉起桌面端，消息装包成 Codex Responses WebSocket 帧直发后端；断线重连 5 次，绝不走 HTTP。
WS_BASE_URL=https://chatgpt.com/backend-api/codex
WS_MODEL=
WS_ORIGINATOR=codex_chatgpt_desktop
WS_OPENAI_BETA=responses_websockets=2026-02-06
WS_RECONNECT_LIMIT=5
WS_CONNECT_TIMEOUT_SECONDS=15
WS_TURN_TIMEOUT_SECONDS=180

COCKPIT_STATE_DIR=
DESKTOP_INSTANCE_ID=
DESKTOP_INSTANCE_NAME=
DESKTOP_PROFILE_DIR=
DESKTOP_APP_USER_DATA_DIR=
DESKTOP_LAUNCH_COMMAND=
DESKTOP_INSTANCE_POOL=
ACTIVATION_WORKER_COUNT=3
DESKTOP_BACKGROUND_MODE=true
DESKTOP_ALLOW_FOREGROUND_FALLBACK=false
ACTIVATION_POLL_SECONDS=0.5
DESKTOP_START_TIMEOUT_SECONDS=90
DESKTOP_RESPONSE_TIMEOUT_SECONDS=180
DESKTOP_RETRY_LIMIT=1
DESKTOP_IDLE_TIMEOUT_SECONDS=600
DESKTOP_AUTOCLOSE=true
DESKTOP_REQUIRE_ACCOUNT_VERIFICATION=true

DELIVERY_WORKER_COUNT=6
DELIVERY_RETRY_LIMIT=5
DELIVERY_RETRY_BASE_SECONDS=1
OAUTH_REAUTH_RETRY_LIMIT=3
OAUTH_REAUTH_RETRY_DELAYS=2,5,10


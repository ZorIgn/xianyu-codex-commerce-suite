# Local service configuration.
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xianyu
MYSQL_PASSWORD=xianyu@2026
MYSQL_DATABASE=xianyu_auto_reply

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=xianyu@2026
REDIS_DB=0

WEBSOCKET_PORT=8090
BACKEND_WEB_SERVICE_URL=http://127.0.0.1:8089
AUTO_START_WEBSOCKET=true
BROWSER_HEADLESS=true

# Payment amount race recovery. Values are finite and bounded by the service.
AUTO_DELIVERY_PAYMENT_MAX_ATTEMPTS=4
AUTO_DELIVERY_PAYMENT_RETRY_BASE_SECONDS=1
AUTO_DELIVERY_PAYMENT_RETRY_MAX_SECONDS=8

# Fulfillment-center integration. Replace the item scope before real use.
FULFILLMENT_CENTER_ENABLED=true
FULFILLMENT_CENTER_URL=http://127.0.0.1:8765
FULFILLMENT_CENTER_ITEM_IDS=replace-with-item-id
FULFILLMENT_CENTER_ALL_ITEMS=false
FULFILLMENT_CENTER_TIMEOUT=5
FULFILLMENT_QUANTITY_RETRIES=3
FULFILLMENT_QUANTITY_RETRY_DELAY=0.25

# Root example only. Copy to .env and adjust locally. Do not commit real secrets.

# Fulfillment center bridge used by services/xianyu-auto-reply/websocket
FULFILLMENT_CENTER_ENABLED=true
FULFILLMENT_CENTER_URL=http://127.0.0.1:8765
FULFILLMENT_CENTER_TIMEOUT=30

# Local service ports
FULFILLMENT_CENTER_PORT=8765
XIANYU_FRONTEND_PORT=9000
XIANYU_BACKEND_WEB_PORT=8089
XIANYU_WEBSOCKET_PORT=8090
XIANYU_SCHEDULER_PORT=8091

# Codex CLI command, customize if your local command differs
CODEX_CLI=codex
